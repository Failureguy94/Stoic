<?xml version="1.0" encoding="utf-8"?>
<!--
  Shorts & Reels blocker. Android only delivers events from the two packages listed,
  and the service reads view ids (not text) to recognise the Shorts/Reels player.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:packageNames="com.google.android.youtube,com.instagram.android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="false"
    android:description="@string/stoic_reels_description"
    android:summary="@string/stoic_reels_summary"
    android:notificationTimeout="200" />
