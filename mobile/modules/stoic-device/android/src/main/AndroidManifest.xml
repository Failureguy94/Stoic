<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!-- "Usage access": the user grants this in Settings; it is never granted silently. -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

  <!-- Bedtime can turn on Do Not Disturb. The user grants "Do Not Disturb access" in Settings. -->
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

  <!-- See only apps that have a launcher icon (no "all installed apps" permission),
       plus the apps that handle essential jobs, which schedules must never block (Essentials.kt). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
    <intent>
      <action android:name="android.intent.action.SHOW_ALARMS" />
    </intent>
    <intent>
      <action android:name="android.settings.SETTINGS" />
    </intent>
    <intent>
      <action android:name="android.intent.action.DIAL" />
    </intent>
    <!-- Strict mode covers the uninstall screen. -->
    <intent>
      <action android:name="android.intent.action.DELETE" />
      <data android:scheme="package" />
    </intent>
  </queries>

  <application>
    <service
        android:name=".StoicAccessibilityService"
        android:exported="true"
        android:label="@string/stoic_a11y_label"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/stoic_accessibility_service" />
    </service>

    <!-- Notification control. The user grants "Notification access" in Settings. -->
    <service
        android:name=".StoicNotificationListener"
        android:exported="true"
        android:label="@string/stoic_notif_label"
        android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <activity
        android:name=".BlockActivity"
        android:excludeFromRecents="true"
        android:exported="false"
        android:launchMode="singleInstance"
        android:taskAffinity="app.stoic.hub.block"
        android:theme="@style/StoicBlockTheme" />
  </application>
</manifest>
