<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!-- "Usage access": the user grants this in Settings; it is never granted silently. -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

  <!-- See only apps that have a launcher icon (no "all installed apps" permission). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <service
        android:name=".StoicAccessibilityService"
        android:exported="true"
        android:label="@string/stoic_a11y_label"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/stoic_accessibility_service" />
    </service>

    <activity
        android:name=".BlockActivity"
        android:excludeFromRecents="true"
        android:exported="false"
        android:launchMode="singleInstance"
        android:taskAffinity="app.stoic.hub.block"
        android:theme="@style/StoicBlockTheme" />
  </application>
</manifest>
