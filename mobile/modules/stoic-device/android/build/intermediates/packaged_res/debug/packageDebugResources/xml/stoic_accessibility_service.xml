<?xml version="1.0" encoding="utf-8"?>
<!--
  Only "a window opened" events, and canRetrieveWindowContent=false:
  the service learns which app is in front and nothing about its contents.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/stoic_a11y_description"
    android:summary="@string/stoic_a11y_summary"
    android:notificationTimeout="100" />
